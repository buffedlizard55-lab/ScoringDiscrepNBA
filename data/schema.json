{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NBA Scoring Discrepancy Record",
  "type": "object",
  "required": ["id", "game_id", "date", "teams", "incident_type", "description", "original_value", "corrected_value", "final_official_value", "sources", "verification_status", "nba_official_record_incorrect"],
  "properties": {
    "id": {"type": "string", "description": "Unique case identifier, e.g. DISC-20241023-GSW-POR-001"},
    "game_id": {"type": "string", "description": "NBA Game ID or date+teams"},
    "date": {"type": "string", "format": "date", "description": "Game date YYYY-MM-DD"},
    "teams": {
      "type": "object",
      "properties": {
        "home": {"type": "string"},
        "away": {"type": "string"},
        "home_abbr": {"type": "string"},
        "away_abbr": {"type": "string"}
      }
    },
    "season": {"type": "string"},
    "period_clock": {"type": "string", "description": "Period and game clock when incident occurred, e.g. Q3 2:00"},
    "relevant_scoring_play": {"type": "string"},
    "score_before": {"type": "string"},
    "score_after_original": {"type": "string"},
    "score_after_corrected": {"type": "string"},
    "original_value": {
      "type": "object",
      "properties": {
        "final_score": {"type": "string"},
        "total_points": {"type": "integer"},
        "player_stat": {"type": "string"}
      }
    },
    "corrected_value": {
      "type": "object",
      "properties": {
        "final_score": {"type": "string"},
        "total_points": {"type": "integer"},
        "player_stat": {"type": "string"}
      }
    },
    "final_official_value": {
      "type": "object",
      "properties": {
        "final_score": {"type": "string"},
        "total_points": {"type": "integer"}
      }
    },
    "affected_player": {"type": "string"},
    "affected_team": {"type": "string"},
    "sources_that_disagreed": {"type": "array", "items": {"type": "string"}},
    "timestamps": {
      "type": "object",
      "properties": {
        "game_time": {"type": "string"},
        "detection_time": {"type": "string"},
        "correction_announced": {"type": "string"},
        "correction_applied": {"type": "string"}
      }
    },
    "what_changed": {"type": "string"},
    "when_changed": {"type": "string"},
    "cause": {"type": "string", "description": "Confirmed or suspected cause"},
    "cause_confidence": {"type": "string", "enum": ["confirmed", "suspected", "under_investigation", "disputed"]},
    "incident_type": {"type": "string", "enum": ["free_throw_not_counted", "three_pointer_misclassified", "scorebook_foul_miscount", "illegal_substitution", "buzzer_beater_disputed", "throw_in_location_error", "technical_foul_miscount", "lane_violation_misapplication", "scoreboard_data_feed_error", "scorebug_timeout_error", "other"]},
    "nba_official_record_incorrect": {"type": "boolean", "description": "True if NBA's official record itself was incorrect, false if only secondary source"},
    "secondary_source_error": {"type": "boolean"},
    "impact_on_final_total": {"type": "boolean"},
    "impact_points": {"type": "integer"},
    "protest_filed": {"type": "boolean"},
    "protest_upheld": {"type": "boolean"},
    "resolution": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "type": {"type": "string", "enum": ["official_nba", "official_team", "espn", "ap", "news", "forum", "video", "other"]},
          "archived_url": {"type": "string"},
          "access_date": {"type": "string"}
        }
      }
    },
    "verification_status": {"type": "string", "enum": ["verified", "partially_verified", "unverified", "disputed", "requires_investigation"]},
    "investigation_status": {"type": "string", "enum": ["detected", "investigating", "corrected", "resolved", "closed"]},
    "notes": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
